{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "PaymentRules": {
    "ApprovalThreshold": 50000,
    "DoubleApprovalThreshold": 200000
  },
  "Jwt": {
    "Issuer": "SebPortal.Api",
    "Audience": "SebPortal.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "starttls",
    "FromAddress": "noreply@seb-portal.local",
    "FromName": "SEB Företagsbetalningar",
    "MaxAttempts": 3,
    "RetryBaseDelayMilliseconds": 1000
  },
  "Batch": {
    "MaxFileSizeBytes": 1048576,
    "MaxRows": 1000
  },
  "App": {
    "PublicUrl": "http://localhost:8081",
    "MigrateOnStartup": true,
    "SeedDemoData": true,
    "ResetLegacyDatabase": false
  },
  "RateLimiting": {
    "LoginPerMinute": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
