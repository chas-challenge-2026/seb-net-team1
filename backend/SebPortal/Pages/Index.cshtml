@page
@model SebPortal.Pages.IndexModel
@{
    ViewData["Title"] = "Logga in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SEB Företagsbetalningar – Logga in</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #006831; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { max-width: 400px; width: 100%; }
        .login-logo { color: #006831; font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
        .btn-seb { background-color: #006831; color: #fff; border: none; width: 100%; }
        .btn-seb:hover { background-color: #004d22; color: #fff; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="card shadow-lg">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="login-logo">SEB</div>
                    <p class="text-muted mt-1">Företagsbetalningar</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label for="email" class="form-label">E-post</label>
                        <input type="email" class="form-control" id="email" name="email"
                               value="@Model.Email" placeholder="din@företag.se" required />
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Lösenord</label>
                        <input type="password" class="form-control" id="password" name="password" required />
                    </div>
                    <button type="submit" class="btn btn-seb mt-2">Logga in</button>
                </form>
            </div>
        </div>
        <p class="text-center text-white mt-3 small">© 2024 SEB – Alla rättigheter förbehållna</p>
    </div>
</body>
</html>
